# Runtime environment: dev | prod | test
ENV=dev
LOG_LEVEL=INFO

# Discord bot token (required to run bot)
DISCORD_TOKEN=your-discord-bot-token-here
# Optional: restrict command sync to one guild in dev for instant updates
DISCORD_GUILD_ID=

# PostgreSQL async SQLAlchemy URL
DATABASE_URL=postgresql+asyncpg://familybot:familybot@localhost:5432/familybot
# Optional: separate database for integration tests; without it they are skipped locally
TEST_DATABASE_URL=

# HTTP healthcheck endpoint
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Optional Sentry DSN
SENTRY_DSN=
